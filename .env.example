# --- Application ---
APP_NAME=WHO Case Reporting API
APP_VERSION=1.0.0
DEBUG=false

# --- Database (PostgreSQL) ---
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=who_case_reporting

# --- Security / JWT ---
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Bootstrap admin (used by seed script) ---
FIRST_ADMIN_EMAIL=admin@who.int
FIRST_ADMIN_PASSWORD=
